# =======================================================================
# Configuración de variables para Render
# IMPORTANTE: Copiar estas variables al dashboard de Render en:
# Dashboard → Tu servicio → Environment Variables
# =======================================================================

# ============================================================
# CONFIGURACIÓN FLASK (Requerida)
# ============================================================

FLASK_ENV=production
FLASK_APP=api.py
PORT=5000

# ============================================================
# CONFIGURACIÓN OLLAMA (Requerida)
# ============================================================

# URL de tu instancia OLLAMA expuesta
# 
# OPCIÓN 1: ngrok (MÁS SIMPLE) - ngrok http 11434
#   OLLAMA_API_URL=https://a1b2c3d4e5f6.ngrok.io
#
# OPCIÓN 2: ngrok Pro (URL permanente)
#   Mismo comando con token: ngrok http 11434 --authtoken TU_TOKEN
#   OLLAMA_API_URL=https://mi-ollama.ngrok.io
#
# OPCIÓN 3: localhost.run (gratis, URL permanente)
#   ssh -R ollama:80:localhost:11434 localhost.run
#   OLLAMA_API_URL=https://ollama.localhost.run
#
# OPCIÓN 4: Cloudflare Tunnel (gratis, URL permanente)
#   wrangler tunnels connect ollama --url http://localhost:11434
#   OLLAMA_API_URL=https://ollama-xxxxx.trycloudflare.com
#
# OPCIÓN 5: Servidor remoto (AWS, Azure, VPS, etc.)
#   OLLAMA_API_URL=https://tu-servidor.com:11434

OLLAMA_API_URL=https://a1b2c3d4e5f6.ngrok.io

# Modelo a usar (disponibles en tu OLLAMA)
# Opciones comunes: llama2, mistral, neural-chat, orca-mini
OLLAMA_MODEL=llama2

# Timeout en segundos para requests a OLLAMA
# Aumentar si tu OLLAMA es lento (ej: 60)
OLLAMA_TIMEOUT=30

# ============================================================
# CONFIGURACIÓN DE LOGGING (Opcional)
# ============================================================

LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# ============================================================
# CONFIGURACIÓN SERVICENOW (Opcional - Solo si usas)
# ============================================================

# Dejar vacío si no usas ServiceNow
SERVICENOW_INSTANCE=
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
SERVICENOW_CREATE_INCIDENTS=false

# ============================================================
# CÓMO AGREGAR ESTAS VARIABLES EN RENDER
# ============================================================

# 1. Ir a https://dashboard.render.com
# 2. Clickear en tu servicio "log-analyzer-agent"
# 3. Tab "Environment" → "Add Environment Variable"
# 4. Para cada variable arriba:
#    - Key: nombre de la variable (ej: FLASK_ENV)
#    - Value: valor (ej: production)
#    - Click "Save"
# 5. El servicio se redeploya automáticamente

# ============================================================
# SETUP RÁPIDO DE OLLAMA
# ============================================================

# OPCIÓN 1: ngrok (MÁS SIMPLE) - recomendado
#    ngrok http 11434
#    Te mostrará: https://a1b2c3d4e5f6.ngrok.io
#    Usar esa URL como OLLAMA_API_URL
#    Nota: URL cambia cada 8 horas (Plan Free)

# OPCIÓN 2: localhost.run (Gratis, URL permanente)
#    ssh -R ollama:80:localhost:11434 localhost.run
#    Te mostrará: https://ollama.localhost.run
#    Usar esa URL como OLLAMA_API_URL

# OPCIÓN 3: Cloudflare Tunnel (Gratis, URL permanente)
#    npm install -g wrangler@latest
#    wrangler login
#    wrangler tunnels create ollama
#    wrangler tunnels connect ollama --url http://localhost:11434
#    Te mostrará: https://ollama-xxxxx.trycloudflare.com
#    Usar esa URL como OLLAMA_API_URL

# ============================================================
# TESTING DESPUÉS DE DEPLOY
# ============================================================

# Verificar que funciona:
# curl https://log-analyzer-agent.onrender.com/api/health
#
# Debería responder:
# {
#   "status": "OK",
#   "service": "Log Analyzer Agent",
#   "model": "llama2",
#   "ollama_url": "https://ollama-xxxxx.trycloudflare.com"
# }

# ============================================================
# SECUENCIA DE SETUP RECOMENDADA
# ============================================================

# 1. Preparar OLLAMA (5 min):
#    - Asegurarse que está corriendo en http://localhost:11434
#    - Instalar Cloudflare Tunnel
#    - Obtener URL pública (es fija, no cambia)
#
# 2. Crear cuenta en Render (3 min):
#    - Ir a https://render.com
#    - Registrarse
#
# 3. Deploy del agente (5 min):
#    - Pushear código a GitHub
#    - En Render: New → Web Service
#    - Conectar GitHub y seleccionar repositorio
#    - Configurar comandos de build/start
#
# 4. Agregar variables de entorno (2 min):
#    - Copiar estas variables en Render dashboard
#    - Especialmente OLLAMA_API_URL con tu URL
#
# 5. Esperar deploy (2-5 min):
#    - Render descarga código, instala dependencias
#    - Inicia el servicio
#
# 6. Verificar (1 min):
#    - curl https://log-analyzer-agent.onrender.com/api/health
#    - Debería responder OK

# ============================================================
# INFORMACIÓN ÚTIL
# ============================================================

# Render plans:
# - Free ($0): Se pausa después de 15 min sin uso
# - Starter ($7/mes): Siempre activo, perfecto para producción
# - Standard ($25/mes): Más recursos

# Render redeploy automático:
# - Cada push a GitHub dispara un nuevo deploy
# - Ver progreso en dashboard
# - Logs disponibles en tiempo real

# Scalabilidad:
# - Si crece, solo cambiar plan
# - No requiere cambios de código
# - Render maneja balanceo automáticamente
