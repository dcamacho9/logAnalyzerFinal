# ==============================================
# Configuración para Docker Build & Push
# Copia este archivo a .env.local y configura
# ==============================================

# Docker Registry (docker.io = Docker Hub)
DOCKER_REGISTRY=docker.io
# DOCKER_REGISTRY=ghcr.io              # GitHub Container Registry
# DOCKER_REGISTRY=gcr.io               # Google Container Registry
# DOCKER_REGISTRY=xxxx.dkr.ecr.us-east-1.amazonaws.com  # AWS ECR
# DOCKER_REGISTRY=myartifactory.com    # JFrog Artifactory

# Namespace en el registry (tu usuario o organización)
DOCKER_NAMESPACE=mycompany

# Tag de versión
DOCKER_TAG=latest
# DOCKER_TAG=1.0.0
# DOCKER_TAG=v2.1.0

# Credenciales (dejar vacío para prompt interactivo)
DOCKER_USERNAME=
DOCKER_PASSWORD=

# Configuración de OLLAMA
OLLAMA_NUM_GPU=1
OLLAMA_NUM_THREAD=8
OLLAMA_MODEL=llama2
OLLAMA_TIMEOUT=30

# Configuración del Agente
AGENT_CPU_LIMIT=2
AGENT_CPU_RESERVE=1
AGENT_MEMORY_LIMIT=2G
AGENT_MEMORY_RESERVE=1G

# Configuración de MuleSoft Gateway
MULE_LOG_LEVEL=INFO

# Paths de datos (volúmenes)
OLLAMA_DATA_PATH=./data/ollama
AGENT_CACHE_PATH=./data/agent-cache
