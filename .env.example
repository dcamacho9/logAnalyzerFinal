# ==============================================
# Configuración del Log Analyzer Agent
# Copia este archivo a .env y ajusta los valores
# ==============================================

# ==============================================
# Flask & API Configuration
# ==============================================
FLASK_ENV=production
PORT=5000
LOG_LEVEL=INFO

# ==============================================
# OLLAMA Configuration
# ==============================================
# URL del servidor OLLAMA (en Docker Compose)
OLLAMA_API_URL=http://ollama:11434

# Modelo a usar (disponibles: llama2, mistral, neural-chat, etc.)
OLLAMA_MODEL=llama2

# Timeout para consultas a OLLAMA (segundos)
OLLAMA_TIMEOUT=30

# Número de GPUs disponibles (0=CPU only, 1+=GPU)
OLLAMA_NUM_GPU=1

# Número de threads para CPU
OLLAMA_NUM_THREAD=8

# Ruta de datos de OLLAMA (para persistencia)
OLLAMA_DATA_PATH=./data/ollama

# ==============================================
# ServiceNow Integration (Opcional)
# ==============================================
# Instancia de ServiceNow (ej: dev12345)
SERVICENOW_INSTANCE=

# Client ID para OAuth
SERVICENOW_CLIENT_ID=

# Client Secret para OAuth
SERVICENOW_CLIENT_SECRET=

# Crear incidentes automáticamente (true/false)
SERVICENOW_CREATE_INCIDENTS=false

# ==============================================
# Agent Configuration
# ==============================================
# Ruta para cache del agente
AGENT_CACHE_PATH=./data/agent-cache

# Límite de CPU para el contenedor (ej: 2, 2.5)
AGENT_CPU_LIMIT=2

# Memoria máxima para el contenedor (ej: 2G, 4G)
AGENT_MEMORY_LIMIT=2G

# CPU reservada (mínimo garantizado)
AGENT_CPU_RESERVE=1

# Memoria reservada
AGENT_MEMORY_RESERVE=1G

# ==============================================
# Mulesoft Configuration (Si se usa)
# ==============================================
# Nivel de logging de Mule
MULE_LOG_LEVEL=INFO

# Puerto del gateway Mule
MULE_PORT=8081

# ==============================================
# Database Configuration (Si es necesario)
# ==============================================
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=admin
# DB_PASSWORD=secure_password
# DB_NAME=log_analyzer

# ==============================================
# API Keys y Secrets (Agrega según sea necesario)
# ==============================================
# API_KEY=your_api_key_here
# API_SECRET=your_api_secret_here

# ==============================================
# Networking
# ==============================================
# Habilitar CORS (para desarrollo)
CORS_ENABLED=true

# Hosts permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=*

# ==============================================
# Docker Resource Limits (Performance Tuning)
# ==============================================
# Aumentar estos valores si tienes hardware potente
# Disminuir si tienes limitaciones de recursos

# OLLAMA Resource Limits
OLLAMA_CPU_LIMIT=4
OLLAMA_MEMORY_LIMIT=8G
OLLAMA_CPU_RESERVE=2
OLLAMA_MEMORY_RESERVE=4G
