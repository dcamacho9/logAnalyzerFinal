# ========================================================
# Configuración del Stack: API Optimizada + OLLAMA
# ========================================================
# Este archivo configura los servicios para deployment
# en Docker Compose con ngrok 24/7
# ========================================================

# ========================================================
# Flask / API Configuration
# ========================================================
FLASK_ENV=production
FLASK_APP=api_optimized.py
PORT=5000
FLASK_DEBUG=0

# ========================================================
# OLLAMA Configuration
# ========================================================
# URL de OLLAMA (en Docker, comunicación interna)
OLLAMA_API_URL=http://ollama:11434

# Modelo a usar
# Opciones: llama2, mistral, neural-chat, phi, openchat
OLLAMA_MODEL=llama2

# Timeout para llamadas a OLLAMA (segundos)
OLLAMA_TIMEOUT=60

# Habilitar streaming en respuestas
ENABLE_STREAMING=true

# Número de GPU a usar (0 = CPU solo)
OLLAMA_NUM_GPU=1

# Número de threads CPU
OLLAMA_NUM_THREAD=8

# ========================================================
# Log Analyzer Configuration
# ========================================================
LOG_LEVEL=INFO

# Caché de respuestas (para optimizar)
ENABLE_CACHE=true
CACHE_TTL=3600

# ========================================================
# ServiceNow Integration (Opcional)
# ========================================================
# Crear incidentes automáticamente
SERVICENOW_CREATE_INCIDENTS=false

# Credenciales (si deseas activar)
SERVICENOW_INSTANCE=
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=

# ========================================================
# Docker Resource Limits
# ========================================================
# Límites de CPU/Memoria para el agente
AGENT_CPU_LIMIT=2
AGENT_MEMORY_LIMIT=2G
AGENT_CPU_RESERVE=1
AGENT_MEMORY_RESERVE=1G

# ========================================================
# Networking
# ========================================================
# Puerto interno de Docker (no cambiar)
# El ngrok externamente lo expone
INTERNAL_API_PORT=5000
INTERNAL_OLLAMA_PORT=11434

# ========================================================
# Monitoreo y Health Check
# ========================================================
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# ========================================================
# Python Configuration
# ========================================================
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
PIP_NO_CACHE_DIR=1
